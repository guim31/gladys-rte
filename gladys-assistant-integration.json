    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection to RTE",
        "fr": "Tester la connexion à RTE",
        "de": "Verbindung zu RTE testen",
        "es": "Probar la conexión con RTE"
      },
      "description": {
        "en": "Reads éCO2mix, EcoGaz and the regions now, and checks the EcoWatt key when one is given.",
        "fr": "Lit éCO2mix, EcoGaz et les régions tout de suite, et vérifie la clé EcoWatt si elle est renseignée.",
        "de": "Liest éCO2mix, EcoGaz und die Regionen sofort und prüft den EcoWatt-Schlüssel, falls angegeben.",
        "es": "Lee éCO2mix, EcoGaz y las regiones ahora y comprueba la clave EcoWatt si se ha indicado."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "ecowatt_alert",
      "label": {
        "en": "EcoWatt alert announced",
        "fr": "Alerte EcoWatt annoncée",
